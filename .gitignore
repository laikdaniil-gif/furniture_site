.idea/
*.swp
*.swo

# Сборка и кэш
dist/
build/
.cache/

# Отчёты о покрытии кода
coverage/

# Файлы резервных копий
*.bak
*.backup

# Конфигурации, содержащие пароли (кроме шаблонов)
config/local.js
config/development.js

# Папка статики (если не нужно хранить изображения в репозитории)
